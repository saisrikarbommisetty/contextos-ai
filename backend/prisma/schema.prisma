datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String           @id @default(uuid())
  name         String
  email        String           @unique
  passwordHash String
  avatar       String?
  role         String           @default("Developer")
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  projects     Project[]        @relation("ProjectOwner")
  tasks        Task[]           @relation("TaskAssignee")
  sessions     ProjectSession[]
}

model Project {
  id           String           @id @default(uuid())
  name         String
  description  String
  status       String           @default("In Progress") // "In Progress", "Planning", "Completed", "On Hold"
  progress     Int              @default(0)
  ownerId      String
  owner        User             @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  lastActiveAt DateTime         @default(now())
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  tasks        Task[]
  documents    Document[]
  meetings     Meeting[]
  decisions    Decision[]
  activities   Activity[]
  sessions     ProjectSession[]
}

model Task {
  id          String    @id @default(uuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      String    @default("TODO") // "TODO", "IN_PROGRESS", "COMPLETED", "BLOCKED"
  priority    String    @default("MEDIUM") // "LOW", "MEDIUM", "HIGH", "CRITICAL"
  assigneeId  String?
  assignee    User?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Document {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  type        String   @default("DOC") // "API_SPEC", "ARCHITECTURE", "GUIDE", "NOTE", "DESIGN"
  url         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Meeting {
  id           String   @id @default(uuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title        String
  summary      String
  date         DateTime
  participants String // Comma-separated or JSON list of participant names/emails
  createdAt    DateTime @default(now())
}

model Decision {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String
  madeBy      String
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
}

model Activity {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type        String // "TASK_COMPLETED", "DECISION_RECORDED", "DOC_UPDATED", "SCHEMA_CHANGED", "SESSION_RESUMED", "BLOCKER_FLAGGED"
  title       String
  description String?
  entityType  String? // "TASK", "DECISION", "DOCUMENT", "MEETING", "SESSION"
  entityId    String?
  timestamp   DateTime @default(now())
  actorId     String?
}

model ProjectSession {
  id               String    @id @default(uuid())
  projectId        String
  project          Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt        DateTime  @default(now())
  endedAt          DateTime?
  lastViewedEntity String? // e.g. "task:task-123", "doc:doc-456"
  createdAt        DateTime  @default(now())
}
