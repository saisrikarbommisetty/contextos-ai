{
  "name": "contextos-backend",
  "version": "1.0.0",
  "description": "ContextOS API Server, Context Engine & AI Layer",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node ./node_modules/nodemon/bin/nodemon.js --watch src -e ts --exec \"node ./node_modules/ts-node/dist/bin.js src/server.ts\"",
    "build": "node ./node_modules/typescript/bin/tsc",
    "start": "node dist/server.js",
    "prisma:generate": "node ./node_modules/prisma/build/index.js generate",
    "prisma:push": "node ./node_modules/prisma/build/index.js db push",
    "seed": "node ./node_modules/ts-node/dist/bin.js prisma/seed.ts",
    "test": "node ./node_modules/jest/bin/jest.js --detectOpenHandles --forceExit"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.1",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
