# ContextOS Backend Production Environment Configuration

# Database Connection (SQLite for local development, PostgreSQL for Render production)
DATABASE_URL="file:./dev.db"

# Server Configuration
PORT=5000
NODE_ENV=production
CLIENT_URL="https://contextos.vercel.app,http://localhost:5173"

# JWT Authentication Secret (Never expose to client)
JWT_SECRET="generate_a_secure_random_jwt_secret_for_production"

# AI Layer: Google Gemini (Server-side only)
AI_PROVIDER="gemini"
GEMINI_API_KEY="your_google_gemini_api_key_here"
GEMINI_MODEL="gemini-3.1-flash-lite"

# Mode Flags
# DEMO_MODE=false -> Real Multi-User Mode (Default for production)
# DEMO_MODE=true  -> Demo Mode (For hackathon judges)
DEMO_MODE=false
